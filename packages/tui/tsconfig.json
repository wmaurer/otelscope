{
    "extends": "../../tsconfig.effect.json",
    "compilerOptions": {
        "composite": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2024"],
        "jsx": "react-jsx",
        "jsxImportSource": "@opentui/react",
        "erasableSyntaxOnly": true,
        "customConditions": ["@otelscope/source"],
        "outDir": "dist",
        "tsBuildInfoFile": "tsconfig.tsbuildinfo",
        "types": ["node"]
    },
    "include": ["src", "test", "perf"]
}
