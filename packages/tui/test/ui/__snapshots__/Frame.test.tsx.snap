exports[`Frame > draws the help overlay over the current screen 1`] = `
"Runs                                                                                                                    
    service                     started ▾         duration  traces  failed    spans    logs run                         
    support-agent               14:05:00            1.00ms       1                1         run-2                       
    shop-api                    14:03:20             1.00s       1                2         run-1                       
                                                                                                                        
                                                                                                                        
                                                                                                                        
            ┌─ Help · Runs ────────────────────────────────────────────────────────────────────────────────┐            
            │ Runs                                                                                         │            
            │   ⏎              open, or toggle a group                                                     │            
            │   Space          toggle a group                                                              │            
            │   /              filter                                                                      │            
            │   n/N            problem                                                                     │            
            │   S              sort                                                                        │            
            │   r              reverse                                                                     │            
            │                                                                                              │            
