            │   j/k/↑/↓        row                                                                         │            
            │   Ctrl-d/Ctrl-u  half page                                                                   │            
            │   PgDn/PgUp      page                                                                        │            
            │   g/G/Home/End   ends                                                                        │            
            │                                                                                              │            
            │ Global                                                                                       │            
            │   Esc            close, clear the query, or go back                                          │            
            │   ?              help                                                                        │            
            │   !              bad lines                                                                   │            
            │   q              quit                                                                        │            
            │   Ctrl-z         suspend to the shell                                                        │            
            │   Ctrl-c         quit from anywhere                                                          │            
            │                                                                                              │            
